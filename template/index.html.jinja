<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="google0b06af105e67b274">
<title>{{ course_name }} — {{ chapter_title }}</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        osha: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' }
      }
    }
  }
}
</script>
<style>
  .fade-in { animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .opt-btn { transition: all 0.12s ease; }
  .opt-btn:hover:not(.locked) { border-color: #3b82f6; background: #eff6ff; }
  .opt-btn.selected { border-color: #3b82f6; background: #dbeafe; }
  .opt-btn.correct { border-color: #16a34a !important; background: #dcfce7 !important; }
  .opt-btn.wrong { border-color: #dc2626 !important; background: #fef2f2 !important; }
  .opt-btn.reveal-correct { border-color: #16a34a !important; background: #dcfce7 !important; }
</style>
</head>
<body class="bg-gray-50 min-h-screen">

<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-4xl mx-auto px-4 py-4">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-2xl">🏗️</span>
      <div>
        <h1 class="text-lg font-bold text-gray-900">{{ chapter_title }}</h1>
        <p class="text-sm text-gray-500">{{ course_name }}</p>
      </div>
    </div>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-6 space-y-8">

  <!-- ===== Syllabus ===== -->
  <section class="fade-in bg-white rounded-xl border border-gray-200 p-6">
    <h2 class="font-bold text-gray-800 mb-3">📋 Syllabus</h2>
    <ol class="space-y-2">
      {% for item in syllabus %}
      <li class="flex items-start gap-3 text-sm text-gray-700">
        <span class="w-6 h-6 rounded-full bg-osha-50 text-osha-600 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">{{ loop.index }}</span>
        {{ item }}
      </li>
      {% endfor %}
    </ol>
  </section>

  <!-- ===== Core Knowledge Points ===== -->
  <section class="fade-in">
    <h2 class="font-bold text-gray-800 mb-4">📖 Core Knowledge Points</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {% for kp in core_knowledge_points %}
      <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow">
        <h3 class="font-bold text-gray-800 text-sm mb-2">{{ kp.title }}</h3>
        <span class="inline-block text-xs font-mono bg-osha-50 text-osha-700 px-2 py-0.5 rounded mb-3">{{ kp.standard_ref }}</span>
        <p class="text-sm text-gray-600 leading-relaxed">{{ kp.content }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- ===== Practice Questions ===== -->
  <section class="fade-in">
    <h2 class="font-bold text-gray-800 mb-4">📝 Practice Questions</h2>
    <div class="space-y-6" id="quizContainer">
      {% for q in practice_questions %}
      <div class="bg-white rounded-xl border border-gray-200 p-6 question-card" data-qid="{{ q.question_id }}">
        <div class="flex items-start justify-between mb-4">
          <span class="text-xs font-bold text-osha-500 bg-osha-50 px-3 py-1 rounded-full">Question {{ q.question_id }}</span>
        </div>

        <p class="text-gray-800 text-sm leading-relaxed mb-5">{{ q.scenario }}</p>

        {% set labels = ['A', 'B', 'C', 'D'] %}
        <div class="space-y-2.5">
          {% for label in labels %}
          {% set opt_text = q.options[label] %}
          <button
            class="opt-btn w-full text-left border-2 border-gray-200 rounded-lg px-4 py-3 text-sm flex items-start gap-3"
            data-qid="{{ q.question_id }}"
            data-opt="{{ label }}"
            onclick="selectAnswer({{ q.question_id }}, '{{ label }}')">
            <span class="w-6 h-6 rounded-full border-2 border-gray-300 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5 indicator">{{ label }}</span>
            <span class="text-gray-700">{{ opt_text }}</span>
          </button>
          {% endfor %}
        </div>

        <div class="rationale hidden mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg" id="rationale-{{ q.question_id }}">
          <p class="text-sm text-amber-800"><strong>{% if q.correct_option in ['A','E','I','O'] %}✅{% else %}💡{% endif %} Correct Answer: {{ q.correct_option }}</strong></p>
          <p class="text-sm text-amber-700 mt-1">{{ q.rationale }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

</main>

<footer class="max-w-4xl mx-auto px-4 pb-8 text-center">
  <p class="text-xs text-gray-400">Generated from osha_questions.json · Jinja2 Template · For OSHA 30-Hour Construction training purposes only.</p>
</footer>

<script>
const correctAnswers = {
  {% for q in practice_questions %}
  {{ q.question_id }}: "{{ q.correct_option }}"{% if not loop.last %},{% endif %}
  {% endfor %}
};

function selectAnswer(qid, label) {
  const card = document.querySelector(`.question-card[data-qid="${qid}"]`);
  const buttons = card.querySelectorAll('.opt-btn');
  const rationale = document.getElementById(`rationale-${qid}`);

  if (buttons[0].classList.contains('locked')) return;

  const correct = correctAnswers[qid];

  buttons.forEach(btn => {
    const btnOpt = btn.dataset.opt;
    btn.classList.add('locked');
    if (btnOpt === correct) btn.classList.add('correct');
    else if (btnOpt === label && btnOpt !== correct) btn.classList.add('wrong');
    else if (btnOpt === correct) btn.classList.add('reveal-correct');

    const indicator = btn.querySelector('.indicator');
    indicator.classList.remove('border-gray-300');
    if (btnOpt === correct) {
      indicator.classList.add('bg-green-500', 'border-green-500', 'text-white');
      indicator.textContent = '✓';
    } else if (btnOpt === label && btnOpt !== correct) {
      indicator.classList.add('bg-red-500', 'border-red-500', 'text-white');
      indicator.textContent = '✗';
    }
  });

  rationale.classList.remove('hidden');
}
</script>

</body>
</html>
